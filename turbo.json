{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": ["dist/**", "*.tsbuildinfo"] },
    "lint": { "dependsOn": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "gen": { "cache": false }
  }
}
