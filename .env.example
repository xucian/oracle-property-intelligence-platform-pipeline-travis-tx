# Copy to .env (git-ignored) and fill in. Load into one shell only when a step needs it:
#   set -a; . ./.env; set +a
# Never echo these values or write them to another file.

# T6 publication (runbook section 3). The 20-character Filebase token is the S3 access key:
# the publisher reads FILEBASE_ACCESS_KEY, so export FILEBASE_ACCESS_KEY="$FILEBASE_ACCESS_TOKEN" after loading.
FILEBASE_ACCESS_TOKEN=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=travis-tx-oracle-pipeline

PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT_SECRET_ACCESS_TOKEN=

# T9 agent tracing. The deployed chat function never reads this file: the key is copied once into the
# Secrets Manager secret staraptor-agent/langsmith-api-key (runbook section 10) and resolved at run time.
# Local golden-set replays read both lines from the shell.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=staraptor-agent
