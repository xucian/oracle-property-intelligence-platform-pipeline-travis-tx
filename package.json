{
  "name": "oracle-property-intelligence-platform-pipeline-travis-tx",
  "version": "0.1.0",
  "private": true,
  "description": "Travis County, TX Oracle pipeline: Travis county modules mirrored from the kit branch, run records, publication manifests and the hosted query layer.",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "apps/api/cdk",
    "packages/*"
  ],
  "scripts": {
    "elephant-cli": "elephant-cli",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@elephant-xyz/cli": "github:elephant-xyz/elephant-cli#main",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
