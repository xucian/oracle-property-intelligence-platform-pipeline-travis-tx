{
  "name": "@travis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "esbuild src/handlers/api.ts src/handlers/chat.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs --external:@duckdb/node-api --external:@duckdb/node-bindings --banner:js=\"import {createRequire} from 'module';const require=createRequire(import.meta.url);\"",
    "build": "tsc -b && npm run bundle",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --root . --config ../../vitest.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-lambda-powertools/tracer": "^2.36.0",
    "@aws-lambda-powertools/metrics": "^2.36.0",
    "@travis/contract": "*",
    "@travis/query": "*"
  },
  "devDependencies": {
    "@travis/tsconfig": "*",
    "@types/aws-lambda": "^8.10.164",
    "esbuild": "^0.28.2"
  }
}
